! Use the Terminus TTF font
XTerm*vt100.faceName: Terminus
XTerm*vt100.faceSize: 14

! --- Gruvbox Dark Color Palette ---
XTerm*vt100.background: #282828
XTerm*vt100.foreground: #ebdbb2

! Black
XTerm*vt100.color0:   #282828
XTerm*vt100.color8:   #928374
! Red
XTerm*vt100.color1:   #cc241d
XTerm*vt100.color9:   #fb4934
! Green
XTerm*vt100.color2:   #98971a
XTerm*vt100.color10:  #b8bb26
! Yellow
XTerm*vt100.color3:   #d79921
XTerm*vt100.color11:  #fabd2f
! Blue
XTerm*vt100.color4:   #458588
XTerm*vt100.color12:  #83a598
! Magenta
XTerm*vt100.color5:   #b16286
XTerm*vt100.color13:  #d3869b
! Cyan
XTerm*vt100.color6:   #689d6a
XTerm*vt100.color14:  #8ec07c
! White
XTerm*vt100.color7:   #a89984
XTerm*vt100.color15:  #ebdbb2

! Red blinking line cursor (Gruvbox Bright Red)
XTerm*cursorColor:      #fb4934
XTerm*cursorBlink:      true
XTerm*cursorOffTime:    400
XTerm*cursorOnTime:     600
XTerm*vt100.cursorUnderline: false
XTerm*vt100.cursorBar:  true

! Enable smooth scrolling and set high scrollback history
XTerm*vt100.scrollBar:  false
XTerm*saveLines:        999999

! Modern padding and geometry
XTerm*vt100.internalBorder: 10
XTerm*vt100.geometry:       100x30

! Fix-ups for modern behavior
XTerm*vt100.utf8:           true
XTerm*vt100.metaSendsEscape: true

! Add to the bottom of ~/.Xresources
XTerm*vt100.translations: #override \
    Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V: insert-selection(CLIPBOARD)
